        "liquid": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>EIS Stabilisation Section</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;\n            background: #f5f5f5;\n        }\n\n        .eis-section {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 30px 20px;\n            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);\n        }\n\n        .eis-container {\n            display: flex;\n            flex-direction: column;\n            gap: 30px;\n            max-width: 600px;\n            width: 100%;\n            align-items: center;\n        }\n\n        .video-wrapper {\n            position: relative;\n            width: 280px;\n            height: 498px;\n            border-radius: 20px;\n            overflow: hidden;\n            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);\n            background: #000;\n        }\n\n        .video-wrapper video {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            display: block;\n        }\n\n        .content-wrapper {\n            padding: 10px;\n            text-align: center;\n        }\n\n        .content-wrapper h2 {\n            font-size: clamp(18px, 2.5vw, 26px);\n            font-weight: 700;\n            color: #1a1a1a;\n            line-height: 1.4;\n            margin-bottom: 15px;\n        }\n\n        .highlight {\n            display: inline-block;\n            background: linear-gradient(135deg, #00d4ff 0%, #0099ff 100%);\n            color: white;\n            padding: 6px 18px;\n            border-radius: 50px;\n            font-size: clamp(16px, 2.2vw, 22px);\n            font-weight: 800;\n            margin-top: 8px;\n            box-shadow: 0 4px 15px rgba(0, 153, 255, 0.3);\n            transform: rotate(-1deg);\n        }\n\n        @media (max-width: 768px) {\n            .eis-container {\n                gap: 25px;\n                max-width: 400px;\n            }\n\n            .video-wrapper {\n                width: 100%;\n                max-width: 320px;\n                height: 568px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .eis-section {\n                padding: 20px 15px;\n            }\n\n            .video-wrapper {\n                height: 480px;\n            }\n\n            .content-wrapper h2 {\n                margin-bottom: 10px;\n            }\n\n            .highlight {\n                padding: 5px 14px;\n                margin-top: 6px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <section class=\"eis-section\">\n        <div class=\"eis-container\">\n            <div class=\"video-wrapper\">\n                <video autoplay muted loop playsinline>\n                    <source src=\"https://cdn.shopify.com/videos/c/o/v/aded9a40eb774182b0df8393e5db66f3.mov\" type=\"video/mp4\">\n                    Ihr Browser unterstützt das Video-Tag nicht.\n                </video>\n            </div>\n            \n            <div class=\"content-wrapper\">\n                <h2>\n                    Ausgestattet mit fortschrittlicher elektronischer Bildstabilisierung (EIS) für gestochen scharfe, verwacklungsfreie Videos\n                    <span class=\"highlight\">auch bei extremsten Aktivitäten</span>\n                </h2>\n            </div>\n        </div>\n    </section>\n</body>\n</html>",
