        "liquid": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Vorher/Nachher</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 20px;\n            font-family: Arial, sans-serif;\n            background-color: #f5f5f5;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            background-color: white;\n            padding: 40px;\n            border-radius: 10px;\n        }\n\n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n\n        .header h1 {\n            font-size: 3em;\n            color: black;\n            margin: 0;\n            font-weight: bold;\n        }\n\n        .brand {\n            font-size: 2em;\n            color: #0066cc;\n            font-weight: bold;\n            margin-top: 10px;\n        }\n\n        @media (max-width: 768px) {\n            .header h1 {\n                font-size: 2em;\n            }\n            \n            .brand {\n                font-size: 1.5em;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>Vorher/Nachher</h1>\n            <div class=\"brand\">KlarPro</div>\n        </div>\n        \n        <div style=\"width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; scroll-behavior: smooth; padding: 6px 0;\">\n            <div style=\"\n                display: flex;\n                flex-direction: row;\n                gap: 3px;\n                padding: 0 6px;\n                min-width: max-content;\n                justify-content: center;\n            \">\n                <!-- 1ère vidéo -->\n                <div style=\"width: 180px; flex-shrink: 0;\">\n                    <video class=\"video-click\" autoplay muted loop playsinline preload=\"metadata\" style=\"width: 100%; height: 320px; object-fit: cover; border-radius: 6px; cursor: pointer;\">\n                        <source src=\"https://cdn.shopify.com/videos/c/o/v/08a31b3d306a4b9aa51c18d4d8c3ca13.mov\">\n                    </video>\n                </div>\n                <!-- 2e vidéo -->\n                <div style=\"width: 180px; flex-shrink: 0;\">\n                    <video class=\"video-click\" autoplay muted loop playsinline preload=\"metadata\" style=\"width: 100%; height: 320px; object-fit: cover; border-radius: 6px; cursor: pointer;\">\n                        <source src=\"https://cdn.shopify.com/videos/c/o/v/23ab37ddfd8c4ae49f6f4457d1e17ea4.mov\">\n                    </video>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Modal vidéo centré style \"card\" -->\n    <div id=\"video-modal\" style=\"display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); justify-content:center; align-items:center; z-index:9999;\">\n        <div style=\"position:relative; background:#000; padding:10px; border-radius:12px; display:flex; justify-content:center; align-items:center;\">\n            <video id=\"modal-video\" autoplay muted loop style=\"width:320px; max-width:90vw; max-height:80vh; border-radius:12px;\"></video>\n            <span id=\"modal-close\" style=\"position:absolute; top:8px; right:8px; color:white; font-size:24px; font-weight:bold; cursor:pointer;\">&times;</span>\n        </div>\n    </div>\n\n    <script>\n        const modal = document.getElementById('video-modal');\n        const modalVideo = document.getElementById('modal-video');\n        const closeBtn = document.getElementById('modal-close');\n        \n        document.querySelectorAll('.video-click').forEach(video => {\n            video.addEventListener('click', () => {\n                modalVideo.src = video.querySelector('source').src;\n                modal.style.display = 'flex';\n                modalVideo.currentTime = 0;\n                modalVideo.play();\n            });\n        });\n        \n        // Fermer modal au clic sur le fond\n        modal.addEventListener('click', (e) => {\n            if (e.target === modal) {\n                modalVideo.pause();\n                modalVideo.src = '';\n                modal.style.display = 'none';\n            }\n        });\n        \n        // Fermer modal avec le bouton X\n        closeBtn.addEventListener('click', () => {\n            modalVideo.pause();\n            modalVideo.src = '';\n            modal.style.display = 'none';\n        });\n    </script>\n</body>\n</html>",
