        "liquid_MRAyaE": {
          "type": "liquid",
          "settings": {
            "liquid": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Flash-Angebot Timer</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Arial', sans-serif;\n            background: #f5f5f5;\n            padding: 20px;\n        }\n\n        .flash-timer {\n            background: white;\n            border-radius: 15px;\n            padding: 25px;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n            max-width: 400px;\n            text-align: center;\n        }\n\n        .header {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 10px;\n            margin-bottom: 15px;\n        }\n\n        .gift-icon {\n            font-size: 2em;\n        }\n\n        .title {\n            color: #333;\n            font-size: 1.5em;\n            font-weight: bold;\n        }\n\n        .subtitle {\n            color: #555;\n            font-size: 0.95em;\n            margin-bottom: 20px;\n            line-height: 1.4;\n        }\n\n        .timer-display {\n            display: flex;\n            justify-content: center;\n            gap: 8px;\n            font-size: 2.5em;\n            font-weight: bold;\n            color: #333;\n            margin-bottom: 10px;\n        }\n\n        .time-unit {\n            min-width: 50px;\n        }\n\n        .separator {\n            color: #999;\n        }\n\n        .labels {\n            display: flex;\n            justify-content: center;\n            gap: 35px;\n            color: #999;\n            font-size: 0.85em;\n        }\n\n        .label {\n            min-width: 50px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"flash-timer\">\n        <div class=\"header\">\n            <span class=\"gift-icon\">🎁</span>\n            <span class=\"title\">Flash-Angebot: 4 Zubehörteile KOSTENLOS</span>\n        </div>\n        \n        <div class=\"subtitle\">\n            Bestellen Sie jetzt vor Ablauf der Zeit:\n        </div>\n\n        <div class=\"timer-display\">\n            <span class=\"time-unit\" id=\"days\">00</span>\n            <span class=\"separator\">:</span>\n            <span class=\"time-unit\" id=\"hours\">00</span>\n            <span class=\"separator\">:</span>\n            <span class=\"time-unit\" id=\"minutes\">05</span>\n            <span class=\"separator\">:</span>\n            <span class=\"time-unit\" id=\"seconds\">00</span>\n        </div>\n\n        <div class=\"labels\">\n            <span class=\"label\">Tage</span>\n            <span class=\"label\">Std</span>\n            <span class=\"label\">Min</span>\n            <span class=\"label\">Sek</span>\n        </div>\n    </div>\n\n    <script>\n        let totalSeconds = 5 * 60;\n\n        function updateTimer() {\n            const days = Math.floor(totalSeconds / 86400);\n            const hours = Math.floor((totalSeconds % 86400) / 3600);\n            const minutes = Math.floor((totalSeconds % 3600) / 60);\n            const seconds = totalSeconds % 60;\n\n            document.getElementById('days').textContent = String(days).padStart(2, '0');\n            document.getElementById('hours').textContent = String(hours).padStart(2, '0');\n            document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');\n            document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');\n\n            if (totalSeconds === 0) {\n                totalSeconds = 5 * 60;\n            } else {\n                totalSeconds--;\n            }\n        }\n\n        updateTimer();\n        const timerInterval = setInterval(updateTimer, 1000);\n    </script>\n</body>\n</html>"
          }
