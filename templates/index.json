        "liquid": "<div style=\"background-color: #f3f3f3; padding: 2rem 0; text-align: center;\">\n  <h2 style=\"font-size: 1.3rem; font-weight: 700; margin-bottom: 1rem;\">\n    Nuestros Clientes Hablan de nosotros\n  </h2>\n\n  <div style=\"font-size: 1.2rem; margin-bottom: 0.5rem; display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap;\">\n    <span>Excelente <strong>4.7 / 5</strong></span>\n\n    <!-- Image Trustpilot pour 4.5 étoiles -->\n    <img\n      src=\"https://cdn.trustpilot.net/brand-assets/4.1.0/stars/stars-4.5.svg\"\n      alt=\"4.7 étoiles\"\n      style=\"height: 24px; width: auto; vertical-align: middle;\"\n    >\n  </div>\n\n  <div style=\"font-size: 1rem; color: #000; display: flex; justify-content: center; align-items: center; gap: 6px;\">\n    <span>basado sobre <span style=\"text-decoration: underline;\"><strong>+600</strong></span> reseñas</span>\n\n    <!-- Logo Trustpilot officiel -->\n    <span style=\"display: flex; align-items: center; gap: 4px;\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\n        <path fill=\"#00B67A\" d=\"M12 .587l3.668 7.568 8.332 1.151-6.001 5.837 1.417 8.293L12 18.896l-7.416 4.54 1.417-8.293-6.001-5.837 8.332-1.151z\"/>\n      </svg>\n      <span style=\"font-weight: 500;\">Trustpilot</span>\n    </span>\n  </div>\n</div>",
